+func TestHysteria2SUIReportedURL(t *testing.T) {
+	// Same option set and Unicode name as the report, with synthetic secrets.
+	link := "hysteria2://test%3Apass%40word@proxy.example:8443?security=tls&fp=android&sni=proxy.example&alpn=h3&obfs=salamander&obfs-password=sal%2B%25&fastopen=0#%5B%F0%9F%87%B7%F0%9F%87%BA%E2%86%92%F0%9F%87%A9%F0%9F%87%AA%5DDragoNet_HysDEric_Services ♾"
+	s, err := ParseHysteria2URL(link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Password != "test:pass@word" || s.ObfsPassword != "sal+%" || s.Name != "[🇷🇺→🇩🇪]DragoNet_HysDEric_Services ♾" {
+		t.Fatal("S-UI credentials or Unicode name decoded incorrectly")
+	}
+	u := s.ExportToURL()
+	if !strings.Contains(u, "fp=android") || !strings.Contains(u, "security=tls") {
+		t.Fatal("sharing URL lost TLS metadata")
+	}
+	c, err := s.Configuration(PriorInfo{Variant: where.Xray, CoreVersion: "26.3.27"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := json.Marshal(c.CoreOutbound)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), "fingerprint") || strings.Contains(string(b), "android") {
+		t.Fatal("QUIC must use native TLS, not an unsupported uTLS fingerprint")
+	}
+	stream := c.CoreOutbound.StreamSettings
+	if stream.Security != "tls" || stream.TLSSettings.AllowInsecure || stream.TLSSettings.ServerName != "proxy.example" || len(stream.TLSSettings.Alpn) != 1 || stream.TLSSettings.Alpn[0] != "h3" {
+		t.Fatal("S-UI metadata changed certificate verification, SNI or ALPN")
+	}
