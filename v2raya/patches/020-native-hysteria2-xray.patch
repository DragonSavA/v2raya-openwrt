--- /dev/null
+++ b/core/serverObj/xray_native_test.go
@@ -0,0 +1,58 @@
+package serverObj
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/v2rayA/v2rayA/core/v2ray/where"
+)
+
+// The host CI job uses the newly built Xray, rather than only inspecting JSON.
+func TestNativeXrayConfigCompatibility(t *testing.T) {
+	xray := os.Getenv("XRAY_BIN")
+	if xray == "" {
+		t.Skip("XRAY_BIN is required for Xray integration checks")
+	}
+	links := []string{
+		"trojan://password@proxy.example:443?sni=proxy.example&type=tcp&allowInsecure=false",
+		"vless://11111111-1111-4111-8111-111111111111@proxy.example:443?type=ws&security=tls&sni=proxy.example&host=proxy.example&path=%2Fws&encryption=none",
+		"tuic://11111111-1111-4111-8111-111111111111:password@proxy.example:443?alpn=h3&congestion_control=bbr",
+		"hysteria2://password@proxy.example:443?sni=proxy.example",
+		"hy2://password@proxy.example:443?sni=proxy.example&obfs=salamander&obfs-password=secret&upmbps=20&downmbps=80&mport=443,10000-10010",
+	}
+	for i, link := range links {
+		scheme := strings.SplitN(link, ":", 2)[0]
+		obj, err := NewFromLink(scheme, link)
+		if err != nil {
+			t.Fatal(err)
+		}
+		c, err := obj.Configuration(PriorInfo{Variant: where.Xray, CoreVersion: "26.3.27", Tag: "proxy", PluginPort: 41001})
+		if err != nil {
+			t.Fatal(err)
+		}
+		b, err := json.Marshal(map[string]interface{}{"outbounds": []interface{}{c.CoreOutbound}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		file := filepath.Join(t.TempDir(), "config.json")
+		if err = os.WriteFile(file, b, 0600); err != nil {
+			t.Fatal(err)
+		}
+		if out, err := exec.Command(xray, "run", "-test", "-config", file).CombinedOutput(); err != nil {
+			t.Fatalf("Xray rejected %s fixture %d: %v\n%s", scheme, i, err, out)
+		}
+		if output := os.Getenv("XRAY_FIXTURE_DIR"); output != "" {
+			if err = os.MkdirAll(output, 0700); err != nil {
+				t.Fatal(err)
+			}
+			if err = os.WriteFile(filepath.Join(output, "outbound-"+strconv.Itoa(i)+".json"), b, 0600); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
