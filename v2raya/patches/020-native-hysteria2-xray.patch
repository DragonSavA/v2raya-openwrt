@@ -0,0 +1,38 @@
+package configure
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/v2rayA/v2rayA/core/serverObj"
+)
+
+func TestHysteria2StoredServerAndSubscription(t *testing.T) {
+	obj, err := serverObj.NewFromLink("hy2", "hy2://p%40ss@proxy.example:443?obfs=salamander&obfs-password=test&mport=443,5000-5010#node")
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := &ServerRaw{ServerObj: obj}
+	b, err := json.Marshal(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := Bytes2ServerRaw(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.ServerObj.ExportToURL() != obj.ExportToURL() {
+		t.Fatal("database round trip lost Hysteria2 options")
+	}
+	b, err = json.Marshal(SubscriptionRaw{Servers: []ServerRaw{*raw}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub, err := Bytes2SubscriptionRaw(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(sub.Servers) != 1 || sub.Servers[0].ServerObj.ExportToURL() != obj.ExportToURL() {
+		t.Fatal("subscription database round trip")
+	}
+}
