+	"testing"
+
+	"github.com/v2rayA/v2rayA/db"
+	"github.com/v2rayA/v2rayA/db/configure"
+)
+
+func TestHysteria2PlainAndBase64Subscription(t *testing.T) {
+	links := "hysteria2://password@proxy.example:443?sni=proxy.example&fastopen=0#first\nhy2://other@[2001:db8::1]:8443#second\n"
+	servers, _, err := ResolveByLines(links)
+	if err != nil || len(servers) != 2 {
+		t.Fatalf("plain subscription: servers=%d, err=%v", len(servers), err)
+	}
+	for _, srv := range servers {
+		if srv.GetProtocol() != "hysteria2" {
+			t.Fatal("incorrect protocol")
+		}
+	}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(base64.StdEncoding.EncodeToString([]byte(links))))
+	}))
+	defer srv.Close()
+	servers, _, err = ResolveSubscriptionWithClient(srv.URL, srv.Client())
+	if err != nil || len(servers) != 2 {
+		t.Fatalf("base64 subscription: servers=%d, err=%v", len(servers), err)
+	}
+}
+
+func TestHysteria2SingleLinkImport(t *testing.T) {
+	// test-protocols.sh provides an isolated configuration with lite=true.
+	defer db.DB().Close()
+	for _, link := range []string{"hysteria2://password@proxy.example:443#first", "hy2://other@proxy.example:8443#second"} {
+		if err := Import(link, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	servers := configure.GetServers()
+	if len(servers) != 2 || servers[0].ServerObj.GetProtocol() != "hysteria2" || servers[1].ServerObj.GetName() != "second" {
+		t.Fatal("single URI was incorrectly handled as a subscription URL")
+	}
+}
